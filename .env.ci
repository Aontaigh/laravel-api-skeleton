# Environment defaults used by `.github/workflows/ci.yml`.
#
# This file is committed on purpose. Every value is either a CI-only placeholder
# or an override of a Sail-specific default (e.g. DB_HOST=127.0.0.1) so the
# `php-tests` job can talk to the MySQL service exposed by the workflow. Nothing
# here is sensitive - real secrets stay in GitHub Actions Secrets.

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------

APP_NAME="Sample API App"
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=1

# ---------------------------------------------------------------------
# Hashing
# ---------------------------------------------------------------------
#
# Faster hashing for tests - matches phpunit.xml. Argon2id with the lowest valid
# work factors so the suite stays fast; the driver itself is exercised
# identically to production.
#

HASH_DRIVER=argon2id
ARGON_MEMORY=8192
ARGON_THREADS=1
ARGON_TIME=1
HASH_VERIFY=true
HASH_REHASH_ON_LOGIN=true
BCRYPT_ROUNDS=4

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
#
# Points at the MySQL service exposed by ci.yml.
#

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=testing
DB_USERNAME=sail
DB_PASSWORD=password

# ---------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# ---------------------------------------------------------------------
# Filesystems
# ---------------------------------------------------------------------

FILESYSTEM_DISK=local

# ---------------------------------------------------------------------
# Queue
# ---------------------------------------------------------------------

QUEUE_CONNECTION=sync

# ---------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------

CACHE_STORE=file

# ---------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------

MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ci@sample-api-app.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# Telescope
# ---------------------------------------------------------------------

TELESCOPE_ENABLED=false

# ---------------------------------------------------------------------
# API Rate Limits
# ---------------------------------------------------------------------

API_RATE_LIMIT_PER_MINUTE=500
API_TOKEN_RATE_LIMIT_PER_MINUTE=10
API_TOKEN_EXPIRATION_DAYS=90
API_AUTH_RATE_LIMIT_PER_MINUTE=5
API_AUTH_IP_CEILING_PER_MINUTE=20
API_CLIENT_AUTH_RATE_LIMIT_PER_MINUTE=5
API_CLIENT_AUTH_IP_CEILING_PER_MINUTE=20

# ---------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------
#
# Leave unset in CI; testing defaults allow common dev-server ports.
#

# CORS_ALLOWED_ORIGINS=
# CORS_SUPPORTS_CREDENTIALS=false
# CORS_MAX_AGE=3600
