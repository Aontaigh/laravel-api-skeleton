<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <!--
                app/Providers/TelescopeServiceProvider.php is scaffolding
                published by `php artisan telescope:install`, not hand-written
                business logic. It only wires Telescope's own gate and filters
                and is never booted in the `testing` environment (see
                AppServiceProvider::register()), so measuring its line
                coverage against the 90% floor would penalise untouched
                vendor boilerplate rather than this application's code.
            -->
            <file>app/Providers/TelescopeServiceProvider.php</file>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- Password hashing — Hash service reads these at config boot. phpunit.xml
             is the source for hashing during PHPUnit runs; .env.ci mirrors the same
             values for CI parity (DB and other vars still come from .env.ci there).
             Low-cost argon2id keeps the suite fast; BCRYPT_ROUNDS remains for the
             bcrypt fallback options in config/hashing.php. -->
        <env name="HASH_DRIVER" value="argon2id"/>
        <env name="ARGON_MEMORY" value="8192"/>
        <env name="ARGON_THREADS" value="1"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="HASH_VERIFY" value="true"/>
        <env name="HASH_REHASH_ON_LOGIN" value="true"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_DATABASE" value="testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="SECURITY_CSP_ENFORCE" value="true"/>
    </php>
</phpunit>
