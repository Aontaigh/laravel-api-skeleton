# Install scripts are denied by default: a dependency that needs one is a review
# decision, not something a routine `npm ci` gets to run.
ignore-scripts=true
# Report advisories during installs as well as in the explicit CI audit.
audit=true
# A dependency range that disagrees with the runtime is a failure, not a warning.
# This also enforces `package.json`'s `engines.npm` on every install and `npm ci`.
engine-strict=true
# Refuse a release until it has been public for a week, so a compromised or
# withdrawn publish is caught by the registry before it reaches this tree.
#
# npm added `min-release-age` in 11.10.0 (npm/cli#8965). An older npm ignores the
# key silently, which is why package.json declares `engines.npm >=11.10.0` and
# `engine-strict` is on: the gate is the install, not a comment in a workflow.
# The `.nvmrc` Node (24.22.1) bundles npm 11.19.1, and CI installs that same
# version on every matrix leg.
min-release-age=7
