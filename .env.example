APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Set to false in production — never deploy with APP_DEBUG=true
APP_DEBUG=true
APP_URL=http://localhost

# Optional override; defaults to the version in composer.json (keep in sync on release).
# APP_VERSION=1.5.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sample_api_app
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

API_RATE_LIMIT_PER_MINUTE=500
API_TOKEN_RATE_LIMIT_PER_MINUTE=10
API_TOKEN_EXPIRATION_DAYS=90

# Auth endpoints (login/register): composite credential+IP limit plus a broad per-IP
# ceiling. The ceiling is skipped in `local` so the dev suite never self-throttles.
API_AUTH_RATE_LIMIT_PER_MINUTE=5
API_AUTH_IP_CEILING_PER_MINUTE=20
API_TWO_FACTOR_SEND_RATE_LIMIT_PER_MINUTE=5
API_TWO_FACTOR_SEND_IP_CEILING_PER_MINUTE=20
API_TWO_FACTOR_VERIFY_RATE_LIMIT_PER_MINUTE=5
API_TWO_FACTOR_VERIFY_IP_CEILING_PER_MINUTE=20
API_TWO_FACTOR_STATUS_RATE_LIMIT_PER_MINUTE=60
API_CLIENT_AUTH_RATE_LIMIT_PER_MINUTE=5
API_CLIENT_AUTH_IP_CEILING_PER_MINUTE=20

# Two-factor code and pending-challenge TTLs (seconds) and per-code guess budget.
# API_TWO_FACTOR_CODE_TTL_SECONDS=300
# API_TWO_FACTOR_PENDING_TTL_SECONDS=300
# API_TWO_FACTOR_MAX_ATTEMPTS=5

# Comma-separated browser origins allowed to call the API from another host.
# Leave empty in local/testing to allow common dev-server ports (:3000, :5173).
# Required in production — e.g. https://app.example.com,https://www.example.com
# CORS_ALLOWED_ORIGINS=
# CORS_SUPPORTS_CREDENTIALS=false
# CORS_MAX_AGE=3600

# Optional HTTP Basic Auth for /api/docs and /api/openapi.yaml (leave empty for public docs)
# API_DOCS_BASIC_AUTH_USER=
# API_DOCS_BASIC_AUTH_PASSWORD=

# Security headers — HSTS max-age (seconds) and CSP enforce/report-only toggle.
# SECURITY_HSTS_MAX_AGE=31536000
# SECURITY_CSP_ENFORCE=true
