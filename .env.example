# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Optional override; defaults to the version in composer.json (keep in sync on release).
# APP_VERSION=1.5.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# ---------------------------------------------------------------------
# Hashing
# ---------------------------------------------------------------------
#
# Argon2id driver with explicit work factors. Rehash-on-login transparently
# upgrades hashes made with older work factors on next sign-in. BCRYPT_ROUNDS
# only keeps the framework's bcrypt fallback options defined.
#

HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4
HASH_VERIFY=true
HASH_REHASH_ON_LOGIN=true
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sample_api_app
DB_USERNAME=sail
DB_PASSWORD=password

# ---------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Must be true in any TLS environment (`staging`, `production`): false is
# local-only so the cookie can flow over plain HTTP. A session cookie sent
# without the Secure flag travels in cleartext on any mixed-content hop.
SESSION_SECURE_COOKIE=false

# ---------------------------------------------------------------------
# Filesystems
# ---------------------------------------------------------------------

FILESYSTEM_DISK=local

# ---------------------------------------------------------------------
# Queue
# ---------------------------------------------------------------------

QUEUE_CONNECTION=redis

# ---------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------

CACHE_STORE=redis
# CACHE_PREFIX=

# ---------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# API Rate Limits
# ---------------------------------------------------------------------
#
# Auth endpoints (login/register): composite credential+IP limit plus a broad
# per-IP ceiling. The ceiling is skipped in `local` so the dev suite never
# self-throttles.
#

API_RATE_LIMIT_PER_MINUTE=500
API_TOKEN_RATE_LIMIT_PER_MINUTE=10
API_TOKEN_EXPIRATION_DAYS=90

# Public status page (GET /status): per-IP only - there is no authenticated User to key on.
API_STATUS_RATE_LIMIT_PER_MINUTE=30

API_AUTH_RATE_LIMIT_PER_MINUTE=5
API_AUTH_IP_CEILING_PER_MINUTE=20
API_TWO_FACTOR_SEND_RATE_LIMIT_PER_MINUTE=5
API_TWO_FACTOR_SEND_IP_CEILING_PER_MINUTE=20
API_TWO_FACTOR_VERIFY_RATE_LIMIT_PER_MINUTE=5
API_TWO_FACTOR_VERIFY_IP_CEILING_PER_MINUTE=20
API_TWO_FACTOR_STATUS_RATE_LIMIT_PER_MINUTE=60
API_CLIENT_AUTH_RATE_LIMIT_PER_MINUTE=5
API_CLIENT_AUTH_IP_CEILING_PER_MINUTE=20

# ---------------------------------------------------------------------
# Password Reset
# ---------------------------------------------------------------------
#
# Forgot/reset: same composite email+IP pattern as auth. E-mail destinations
# (SPA pages) fall back to the API host (`/reset-password`, `/forgot-password`)
# for local development only when left empty.
#

API_PASSWORD_RESET_RATE_LIMIT_PER_MINUTE=5
API_PASSWORD_RESET_IP_CEILING_PER_MINUTE=20

API_PASSWORD_RESET_URL=
API_PASSWORD_FORGOT_URL=

# ---------------------------------------------------------------------
# Two-Factor Authentication
# ---------------------------------------------------------------------
#
# Code and pending-challenge TTLs (seconds) and per-code guess budget.
#

# API_TWO_FACTOR_CODE_TTL_SECONDS=300
# API_TWO_FACTOR_PENDING_TTL_SECONDS=300
# API_TWO_FACTOR_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------
#
# Comma-separated browser origins allowed to call the API from another host.
# Leave empty in local/testing to allow common dev-server ports (:3000, :5173).
# Required in production - e.g. https://app.example.com,https://www.example.com
#

# CORS_ALLOWED_ORIGINS=
# CORS_SUPPORTS_CREDENTIALS=false
# CORS_MAX_AGE=3600

# ---------------------------------------------------------------------
# API Documentation
# ---------------------------------------------------------------------
#
# Optional HTTP Basic Auth for /api/docs and /api/openapi.yaml (leave empty
# for public docs).
#

# API_DOCS_BASIC_AUTH_USER=
# API_DOCS_BASIC_AUTH_PASSWORD=

# ---------------------------------------------------------------------
# Security Headers
# ---------------------------------------------------------------------
#
# HSTS max-age (seconds) and CSP enforce/report-only toggle.
#

# SECURITY_HSTS_MAX_AGE=31536000
# SECURITY_CSP_ENFORCE=true

# Trusted proxy IPs or CIDRs (comma-separated) for X-Forwarded-* headers
# behind a load balancer, so client IPs resolve for rate limits and audit
# rows. Empty by default: direct exposure trusts nothing. Never set `*` -
# a wildcard lets clients spoof their address and bypass IP limits.

# TRUSTED_PROXIES=

# ---------------------------------------------------------------------
# GeoIP
# ---------------------------------------------------------------------
#
# MaxMind GeoLite2 credentials used only by the weekly `geoip:update`
# download (runs Sundays 03:15 UTC in `staging`/`production`). Leave both
# empty to skip the download - location lookups fail open without the
# database file. Credentials are secrets: never commit real values.
#

MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
GEOIP_DATABASE=storage/geoip/GeoLite2-City.mmdb

# Public IP looked up in `local` when the caller IP is private or loopback
# (GeoLite2 has no data for those ranges). Ignored outside `local`.
# GEOIP_LOCAL_FALLBACK_IP=8.8.8.8

# Override the GeoLite2 download endpoint - useful for tests, where
# `Http::fake` intercepts the request instead of hitting MaxMind.
# GEOIP_DOWNLOAD_URL=
