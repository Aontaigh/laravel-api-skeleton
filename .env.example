# Template for every environment - copy to `.env` and fill in real values.
# Documents each key the app reads; placeholders only, never real secrets.
# Consumed by local Sail runs, CI (via `.env.ci`), and deploys (via vault
# injection). Behavioural docs live in `config/` - this file documents values.
#
# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
#
# Sail defaults below. CI copies `.env.ci` to `.env` in `ci.yml`; injected
# environment values win over file values when both define the same key.
#

APP_NAME=Laravel
APP_ENV=local
# Application encryption key (required, string). Generate with `php artisan key:generate`.
# Rotating invalidates encrypted cookies and any data sealed with the prior key.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Optional override (optional, string); defaults to the version in `composer.json`.
# APP_VERSION=1.5.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# Database-backed maintenance store when `APP_MAINTENANCE_DRIVER=database`; ignored when unset.
# APP_MAINTENANCE_STORE=database

# Built-in PHP dev server worker count (optional, integer); framework default applies when unset.
# PHP_CLI_SERVER_WORKERS=4

# ---------------------------------------------------------------------
# Hashing
# ---------------------------------------------------------------------
#
# Argon2id driver with explicit work factors. Rehash-on-login transparently
# upgrades hashes made with older work factors on next sign-in. BCRYPT_ROUNDS
# only keeps the framework's bcrypt fallback options defined.
#

HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4
HASH_VERIFY=true
HASH_REHASH_ON_LOGIN=true
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sample_api_app
DB_USERNAME=sail
# Database password (required, string). Sail default shown.
DB_PASSWORD=password

# ---------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Must be true in any TLS environment (`staging`, `production`): false is
# local-only so the cookie can flow over plain HTTP. A session cookie sent
# without the Secure flag travels in cleartext on any mixed-content hop.
SESSION_SECURE_COOKIE=false

# ---------------------------------------------------------------------
# Filesystems
# ---------------------------------------------------------------------

FILESYSTEM_DISK=local

# ---------------------------------------------------------------------
# Queue
# ---------------------------------------------------------------------

QUEUE_CONNECTION=redis

# ---------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------

CACHE_STORE=redis
# Redis key prefix (optional, string); framework derives from `APP_NAME` when unset.
# CACHE_PREFIX=

# ---------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# Telescope
# ---------------------------------------------------------------------
#
# Request inspector (optional). Disabled by default in `testing` and CI. Enable
# in `local` only when debugging (`TELESCOPE_ENABLED=true`).
#

TELESCOPE_ENABLED=false

# ---------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------
#
# Login timing normalisation (optional). Dummy hash compared when the email is
# unknown; resolved at boot from the configured hash driver when unset.
#

# API_AUTH_TIMING_NORMALISATION_HASH=

# ---------------------------------------------------------------------
# API Rate Limits
# ---------------------------------------------------------------------
#
# Per-minute request budgets. Credential-bearing endpoints pair a tight
# credential+IP limit with a broad per-IP ceiling; the ceiling is skipped in
# `local` so the dev suite never self-throttles.
#

# General authenticated API.
API_RATE_LIMIT_PER_MINUTE=500

# Personal access token creation.
API_TOKEN_RATE_LIMIT_PER_MINUTE=10

# Public status page (GET /status): per-IP only - there is no authenticated User to key on.
API_STATUS_RATE_LIMIT_PER_MINUTE=30

# Health probes (GET /health): per-IP only - same shape as the status page.
API_HEALTH_RATE_LIMIT_PER_MINUTE=60

# Login, registration, and other credential-bearing auth endpoints.
API_AUTH_RATE_LIMIT_PER_MINUTE=5
API_AUTH_IP_CEILING_PER_MINUTE=20

# Two-factor send, verify, and status polling.
API_TWO_FACTOR_SEND_RATE_LIMIT_PER_MINUTE=5
API_TWO_FACTOR_SEND_IP_CEILING_PER_MINUTE=20
API_TWO_FACTOR_VERIFY_RATE_LIMIT_PER_MINUTE=5
API_TWO_FACTOR_VERIFY_IP_CEILING_PER_MINUTE=20
API_TWO_FACTOR_STATUS_RATE_LIMIT_PER_MINUTE=60

# OAuth client-credentials token exchange.
API_CLIENT_AUTH_RATE_LIMIT_PER_MINUTE=5
API_CLIENT_AUTH_IP_CEILING_PER_MINUTE=20

# CSP violation reports: `POST /api/csp-reports` is public and anonymous, so
# its throttle is a generous per-IP ceiling (browsers burst on misconfigured
# pages). Reports land in `storage/logs/csp-reports.log`, never the main log.
API_CSP_REPORT_IP_CEILING_PER_MINUTE=60

# ---------------------------------------------------------------------
# API Tokens
# ---------------------------------------------------------------------
#
# Bearer token lifetimes in days (integer). The demo client secret is a
# documented `local` credential - never enable it outside `local`.
#

API_TOKEN_EXPIRATION_DAYS=90
# Remember-me token lifetime (optional, integer days); defaults to 365 when unset.
# API_REMEMBER_TOKEN_EXPIRATION_DAYS=365
# Client-credentials token lifetime (optional, integer days); defaults to 30 when unset.
# API_CLIENT_TOKEN_EXPIRATION_DAYS=30
# Seeded demo client secret (optional, string); defaults to the documented dev value when unset.
# API_DEMO_CLIENT_SECRET=DemoClientSecret12

# ---------------------------------------------------------------------
# Password Reset
# ---------------------------------------------------------------------
#
# Forgot/reset: same composite email+IP pattern as auth. E-mail destinations
# (SPA pages) fall back to the API host (`/reset-password`, `/forgot-password`)
# for local development only when left empty.
#

# Maximum password field length (optional, integer); defaults to 255 when unset.
# API_PASSWORD_MAX_LENGTH=255

API_PASSWORD_RESET_RATE_LIMIT_PER_MINUTE=5
API_PASSWORD_RESET_IP_CEILING_PER_MINUTE=20

API_PASSWORD_RESET_URL=
API_PASSWORD_FORGOT_URL=

# ---------------------------------------------------------------------
# Email Verification
# ---------------------------------------------------------------------
#
# `API_EMAIL_VERIFICATION_URL` is the SPA page showing the verify outcome;
# `AUTH_VERIFICATION_EXPIRE` is the signed-link TTL in minutes. The verify
# endpoint is public but signature-protected, so its throttle only bounds
# lookup abuse; resend is authenticated and keys on the User ID + IP.
#

API_EMAIL_VERIFICATION_URL=
AUTH_VERIFICATION_EXPIRE=60
API_EMAIL_VERIFY_IP_CEILING_PER_MINUTE=60
API_EMAIL_VERIFICATION_RATE_LIMIT_PER_MINUTE=3

# ---------------------------------------------------------------------
# Two-Factor Authentication
# ---------------------------------------------------------------------
#
# Code and pending-challenge TTLs (optional, integer seconds) and per-code
# guess budget. Defaults to 300 seconds and 5 attempts when unset.
#

# API_TWO_FACTOR_CODE_TTL_SECONDS=300
# API_TWO_FACTOR_PENDING_TTL_SECONDS=300
# API_TWO_FACTOR_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------
# User Agent
# ---------------------------------------------------------------------
#
# Parser for session and audit user-agent enrichment (optional). `basic` or
# `null` to disable; defaults to `basic` when unset.
#

# USER_AGENT_PARSER=basic

# ---------------------------------------------------------------------
# GeoIP
# ---------------------------------------------------------------------
#
# MaxMind GeoLite2 (optional). Credentials used only by the weekly `geoip:update`
# download (Sundays 03:15 UTC in `staging`/`production`). Obtain from the
# MaxMind account portal; leave both empty to skip the download - location
# lookups fail open without the database file. Never commit real values.
#

MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
GEOIP_DATABASE=storage/geoip/GeoLite2-City.mmdb

# Public IP looked up in `local` when the caller IP is private or loopback
# (GeoLite2 has no data for those ranges). Ignored outside `local`; defaults
# to 8.8.8.8 when unset.
# GEOIP_LOCAL_FALLBACK_IP=8.8.8.8

# Override the GeoLite2 download endpoint (optional); MaxMind permalink used when unset.
# GEOIP_DOWNLOAD_URL=

# ---------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------
#
# Vite build-time variables only - never put secrets here; they ship in the
# JavaScript bundle. Restart the Vite dev server after changing these values.
#

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------
#
# Comma-separated browser origins (optional). Leave empty in `local`/`testing`
# to allow common dev-server ports (:3000, :5173). Required in `production` -
# e.g. https://app.example.com,https://www.example.com
#

# CORS_ALLOWED_ORIGINS=
# CORS_SUPPORTS_CREDENTIALS=false
# CORS_MAX_AGE=3600

# ---------------------------------------------------------------------
# API Documentation
# ---------------------------------------------------------------------
#
# Optional HTTP Basic Auth for `/api/docs` and `/api/openapi.yaml` (leave empty
# for public docs).
#

# API_DOCS_BASIC_AUTH_USER=
# API_DOCS_BASIC_AUTH_PASSWORD=

# ---------------------------------------------------------------------
# Security Headers
# ---------------------------------------------------------------------
#
# HSTS max-age (optional, integer seconds) and CSP enforce/report-only toggle.
# Takes effect on the next request in `local`; rebuild `config:cache` in
# `production` after changing these values.
#

# SECURITY_HSTS_MAX_AGE=31536000
# SECURITY_CSP_ENFORCE=true

# Trusted proxy IPs or CIDRs (optional, comma-separated) for X-Forwarded-* headers
# behind a load balancer, so client IPs resolve for rate limits and audit
# rows. Empty by default: direct exposure trusts nothing. Never set `*` -
# a wildcard lets clients spoof their address and bypass IP limits.

# TRUSTED_PROXIES=
