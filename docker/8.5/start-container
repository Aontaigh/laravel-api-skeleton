#!/usr/bin/env bash

if [ "$SUPERVISOR_PHP_USER" != "root" ] && [ "$SUPERVISOR_PHP_USER" != "sail" ]; then
    echo "You should set SUPERVISOR_PHP_USER to either 'sail' or 'root'."
    exit 1
fi

if [ ! -z "$WWWUSER" ]; then
    usermod -u $WWWUSER sail
fi

# `node_modules` is a named volume, and the mount point arrives owned by the build-time uid (1337).
# Sail remaps `sail` to `$WWWUSER` above, so on any host whose uid is not 1337 the volume is owned
# by nobody and every npm command inside the container fails with EACCES on `mkdir`. Align the
# mount point once per start - the tree inside it already belongs to sail.
if [ -d /var/www/html/node_modules ]; then
    chown sail:sail /var/www/html/node_modules
fi

if [ ! -d /.composer ]; then
    mkdir /.composer
fi

chmod -R ugo+rw /.composer

if [ $# -gt 0 ]; then
    if [ "$SUPERVISOR_PHP_USER" = "root" ]; then
        exec "$@"
    else
        exec gosu $WWWUSER "$@"
    fi
else
    exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
fi
